 5 m g 5mg 5 m g C.","source":"自编（经典考法）","difficulty":"中等","applicability":"单选/实验综合","risk":"最高点\"恰能通过\"的临界是绳拉力恰为 0，若写成杆模型 v=0 就全错——先分清\"绳/内轨\"还是\"杆/圆管\"。","fit":["竖直平面圆周运动的临界条件","动能定理/机械能守恒与圆周综合","选填题"],"updated":"Mon Mar 03 2025 08:00:00 GMT+0800 (中国标准时间)"},"breadcrumbs":[{"slug":"physics","title":"物理"},{"slug":"mechanics","title":"力学"},{"slug":"curves","title":"曲线运动与圆周"},{"slug":"circular-critical","title":"竖直平面圆周运动临界（绳模型）"}],"children":[],"siblings":[{"slug":"conical-pendulum","title":"圆锥摆·角速度与摆角的关系","type":"example"},{"slug":"curved-motion","title":"曲线运动与圆周运动","type":"knowledge"},{"slug":"projectile-slope","title":"平抛落斜面（特殊角心算）","type":"example"}]}